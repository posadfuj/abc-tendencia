---
import { WHATSAPP, waLink } from '~/data/tienda';
---

<!-- Botón carrito flotante -->
<button id="cart-btn" aria-label="Ver carrito"
  class="fixed bottom-24 right-6 z-50 rounded-full bg-white flex items-center justify-center ring-1 ring-black/5 hover:scale-110 transition"
  style="width:60px;height:60px;box-shadow:0 10px 26px rgba(56,182,224,.4)">
  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#38B6E0" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="9" cy="21" r="1"></circle>
    <circle cx="20" cy="21" r="1"></circle>
    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
  </svg>
  <span id="cart-badge" class="hidden absolute -top-1.5 -right-1.5 bg-[#FF4D8D] text-white text-sm font-extrabold rounded-full min-w-[24px] h-6 px-1 flex items-center justify-center ring-2 ring-white">0</span>
</button>

<!-- WhatsApp flotante -->
<div class="fixed bottom-6 right-6 z-50" style="width:60px;height:60px">
  <span class="wa-pulse pointer-events-none absolute inset-0 rounded-full bg-[#25D366]"></span>
  <a href={waLink('Hola ABC Tendencia 🐼, quiero hacer un pedido')} target="_blank" rel="noopener" aria-label="WhatsApp"
    class="relative rounded-full bg-[#25D366] text-white text-3xl flex items-center justify-center shadow-2xl hover:scale-110 transition"
    style="width:60px;height:60px">💬</a>
</div>

<style>
  @keyframes wa-pulse {
    0% { scale: 1; opacity: .55; }
    100% { scale: 1.7; opacity: 0; }
  }
  .wa-pulse {
    animation: wa-pulse 1.8s cubic-bezier(0,0,.2,1) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-pulse { animation: none; opacity: 0; }
  }
</style>

<!-- Panel del carrito -->
<div id="cart-overlay" class="hidden fixed inset-0 bg-black/40 z-[60]"></div>
<aside id="cart-panel" class="fixed top-0 right-0 h-full w-full max-w-sm bg-white z-[70] shadow-2xl translate-x-full transition-transform duration-300 flex flex-col">
  <div class="flex items-center justify-between p-5 border-b">
    <h3 class="text-xl font-bold">🛒 Tu carrito</h3>
    <button id="cart-close" class="text-2xl text-gray-400 hover:text-gray-700" aria-label="Cerrar">✕</button>
  </div>
  <div id="cart-items" class="flex-1 overflow-y-auto p-5 space-y-4"></div>
  <div class="p-5 border-t max-h-[55vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-4">
      <span class="text-gray-600">Total:</span>
      <span id="cart-total" class="text-2xl font-extrabold" style="color:#7C5CFC">S/ 0</span>
    </div>

    <p class="text-xs font-bold text-gray-500 mb-2 uppercase tracking-wide">Tus datos para el envío</p>
    <div class="flex flex-col gap-2 mb-4">
      <input id="cart-nombre" type="text" placeholder="Tu nombre" maxlength="120" required
        class="w-full py-2.5 px-4 rounded-full border border-gray-200 text-sm focus:outline-none focus:ring-2"
        style="--tw-ring-color:#7C5CFC" />
      <input id="cart-whatsapp" type="tel" placeholder="Tu WhatsApp" maxlength="20" required
        class="w-full py-2.5 px-4 rounded-full border border-gray-200 text-sm focus:outline-none focus:ring-2"
        style="--tw-ring-color:#7C5CFC" />
      <input id="cart-direccion" type="text" placeholder="Dirección (calle y número)" maxlength="200" required
        class="w-full py-2.5 px-4 rounded-full border border-gray-200 text-sm focus:outline-none focus:ring-2"
        style="--tw-ring-color:#7C5CFC" />
      <input id="cart-distrito" type="text" placeholder="Distrito / Ciudad" maxlength="100" required
        class="w-full py-2.5 px-4 rounded-full border border-gray-200 text-sm focus:outline-none focus:ring-2"
        style="--tw-ring-color:#7C5CFC" />
      <input id="cart-referencia" type="text" placeholder="Referencia (opcional): casa, color, cerca de..." maxlength="200"
        class="w-full py-2.5 px-4 rounded-full border border-gray-200 text-sm focus:outline-none focus:ring-2"
        style="--tw-ring-color:#7C5CFC" />
      <select id="cart-envio" required
        class="w-full py-2.5 px-4 rounded-full border border-gray-200 text-sm focus:outline-none focus:ring-2 bg-white"
        style="--tw-ring-color:#7C5CFC">
        <option value="" disabled selected>¿Cómo prefieres el envío?</option>
        <option value="Delivery Huánuco">🛵 Delivery en Huánuco</option>
        <option value="Envío nacional - Olva Courier">🚚 Envío nacional - Olva Courier</option>
        <option value="Envío nacional - Shalom">🚚 Envío nacional - Shalom</option>
      </select>
      <select id="cart-pago" required
        class="w-full py-2.5 px-4 rounded-full border border-gray-200 text-sm focus:outline-none focus:ring-2 bg-white"
        style="--tw-ring-color:#7C5CFC">
        <option value="" disabled selected>¿Cómo prefieres pagar?</option>
        <option value="Yape">💜 Yape</option>
        <option value="Plin">💙 Plin</option>
        <option value="Transferencia">🏦 Transferencia</option>
        <option value="Contra entrega" data-solo-huanuco="1">📦 Contra entrega (solo Huánuco)</option>
      </select>
    </div>

    <button id="cart-checkout" class="w-full bg-[#25D366] hover:brightness-105 text-white font-bold py-3.5 rounded-full transition">💬 Enviar pedido por WhatsApp</button>
  </div>
</aside>

<script is:inline define:vars={{ WA: WHATSAPP }}>
  (function () {
    const money = (n) => 'S/ ' + Math.round(n * 100) / 100;
    let cart = JSON.parse(localStorage.getItem('abc_cart') || '[]');
    const badge = document.getElementById('cart-badge');
    const panel = document.getElementById('cart-panel');
    const overlay = document.getElementById('cart-overlay');
    const cont = document.getElementById('cart-items');
    const totalEl = document.getElementById('cart-total');

    const guardar = () => localStorage.setItem('abc_cart', JSON.stringify(cart));
    const abrir = () => { panel.classList.remove('translate-x-full'); overlay.classList.remove('hidden'); };
    const cerrar = () => { panel.classList.add('translate-x-full'); overlay.classList.add('hidden'); };

    function render() {
      const n = cart.reduce((s, i) => s + i.qty, 0);
      badge.textContent = n;
      badge.classList.toggle('hidden', n === 0);
      totalEl.textContent = money(cart.reduce((s, i) => s + i.precio * i.qty, 0));
      cont.innerHTML = !cart.length
        ? '<p class="text-center text-gray-400 py-10">Tu carrito está vacío 🧸<br>Agrega tus peluches favoritos.</p>'
        : cart.map((i, idx) => `
          <div class="flex gap-3 items-center">
            <img src="${i.img}" alt="" class="w-16 h-16 rounded-xl object-cover bg-gray-100" />
            <div class="flex-1 min-w-0">
              <p class="font-bold text-sm text-gray-800 truncate">${i.nombre}</p>
              <p class="text-sm font-extrabold" style="color:#7C5CFC">${money(i.precio)}</p>
              <div class="flex items-center gap-2 mt-1">
                <button data-menos="${idx}" class="w-7 h-7 rounded-full bg-gray-100 font-bold">−</button>
                <span class="w-6 text-center font-bold">${i.qty}</span>
                <button data-mas="${idx}" class="w-7 h-7 rounded-full bg-gray-100 font-bold">+</button>
                <button data-quitar="${idx}" class="ml-auto text-red-400 text-sm">🗑️</button>
              </div>
            </div>
          </div>`).join('');
    }

    document.querySelectorAll('.add-cart').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        const ex = cart.find((i) => i.id === id);
        if (ex) ex.qty++;
        else cart.push({ id, nombre: btn.getAttribute('data-nombre'), precio: parseFloat(btn.getAttribute('data-precio')), img: btn.getAttribute('data-img'), qty: 1 });
        guardar(); render(); abrir();
      });
    });

    cont.addEventListener('click', (e) => {
      const t = e.target;
      if (t.dataset.mas !== undefined) cart[t.dataset.mas].qty++;
      else if (t.dataset.menos !== undefined) { const i = cart[t.dataset.menos]; i.qty--; if (i.qty <= 0) cart.splice(t.dataset.menos, 1); }
      else if (t.dataset.quitar !== undefined) cart.splice(t.dataset.quitar, 1);
      else return;
      guardar(); render();
    });

    document.getElementById('cart-btn').addEventListener('click', abrir);
    document.getElementById('cart-close').addEventListener('click', cerrar);
    overlay.addEventListener('click', cerrar);

    // "Contra entrega" solo aplica para delivery en Huánuco.
    const envioSel = document.getElementById('cart-envio');
    const pagoSel = document.getElementById('cart-pago');
    envioSel.addEventListener('change', () => {
      const esHuanuco = envioSel.value === 'Delivery Huánuco';
      const opcionContraentrega = pagoSel.querySelector('[data-solo-huanuco]');
      opcionContraentrega.hidden = !esHuanuco;
      if (!esHuanuco && pagoSel.value === 'Contra entrega') pagoSel.value = '';
    });

    document.getElementById('cart-checkout').addEventListener('click', () => {
      if (!cart.length) { alert('Tu carrito está vacío 🧸'); return; }

      const nombre = document.getElementById('cart-nombre').value.trim();
      const whatsapp = document.getElementById('cart-whatsapp').value.trim();
      const direccion = document.getElementById('cart-direccion').value.trim();
      const distrito = document.getElementById('cart-distrito').value.trim();
      const referencia = document.getElementById('cart-referencia').value.trim();
      const envio = envioSel.value;
      const pago = pagoSel.value;

      if (!nombre || !whatsapp || !direccion || !distrito || !envio || !pago) {
        alert('Completa tus datos de nombre, WhatsApp, dirección, distrito, envío y pago para continuar 📋');
        return;
      }

      let msg = '¡Hola ABC Tendencia! 🐼 Quiero pedir:%0A%0A';
      let total = 0;
      cart.forEach((i) => { msg += `• ${i.qty}x ${i.nombre} — ${money(i.precio * i.qty)}%0A`; total += i.precio * i.qty; });
      msg += `%0A*Total: ${money(total)}*%0A%0A`;
      msg += `*Nombre:* ${encodeURIComponent(nombre)}%0A`;
      msg += `*Dirección:* ${encodeURIComponent(direccion)}, ${encodeURIComponent(distrito)}%0A`;
      if (referencia) msg += `*Referencia:* ${encodeURIComponent(referencia)}%0A`;
      msg += `*Envío:* ${encodeURIComponent(envio)}%0A`;
      msg += `*Pago:* ${encodeURIComponent(pago)}%0A%0A¿Me confirmas disponibilidad? 🚚`;
      window.open(`https://wa.me/${WA}?text=${msg}`, '_blank');

      // Registro en el CRM: no debe bloquear ni romper el checkout si falla.
      try {
        fetch('/api/pedido', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cliente: nombre, whatsapp, direccion, distrito, referencia, envio, pago, items: cart, total }),
          keepalive: true,
        }).catch(() => {});
      } catch (_) { /* no romper el checkout */ }
    });

    render();
  })();
</script>
